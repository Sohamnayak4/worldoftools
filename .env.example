# Copy to .env.local for local work, and add the same names in Vercel.
# Get the API key in the Dodo dashboard under Developer, API Keys.
DODO_PAYMENTS_API_KEY=
# live_mode or test_mode. Test mode needs test products and a test key.
DODO_PAYMENTS_ENVIRONMENT=live_mode
# The two ad products in Dodo.
DODO_PRODUCT_AD_7_DAYS=pdt_0NrnJNnS5PVEZwQWLA6HC
DODO_PRODUCT_AD_30_DAYS=pdt_0NrmBPLYoqMOhiHTUZCLq
# Signing secret of the Dodo webhook that points to
# https://worldof.tools/api/webhooks/dodo (event: payment.succeeded and
# refund.succeeded). Makes paid ads show at once.
DODO_PAYMENTS_WEBHOOK_KEY=

# Optional. Search Console and Bing ownership codes (the content="..." value
# from their HTML tag option). Skip these if you verify with DNS records.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Site API key from Pixelmoth Settings. Lets the server read visitor totals
# for the ad section and the Advertise page. Never expose it to the browser.
PIXELMOTH_API_KEY=
